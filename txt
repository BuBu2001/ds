def update_player(player, dt, input_buffer):
    if player.control_inverted_timer > 0:
        player.control_inverted_timer -= dt
    # ... логика состояний ...

def process_input(raw_input, player):
    move = Vector2(0, 0)
    if raw_input.forward: move.y -= 1
    if raw_input.back:    move.y += 1
    if raw_input.left:    move.x -= 1
    if raw_input.right:   move.x += 1
    if player.control_inverted_timer > 0:
        move.x = -move.x
        move.y = -move.y
    camera.rotation = raw_input.mouse_delta
    player.aim_direction = camera.forward
    return move
